{
  "name": "prompt2ship",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run check:content && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "lint:styles": "stylelint 'src/styles/*.css'",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "verify:todo": "node scripts/verify-todo.mjs",
    "verify:homepage": "node scripts/verify-homepage.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.58.0",
    "motion": "^12.23.0",
    "radix-ui": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^3.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.0"
  }
}
