---
import Layout from "../layouts/Layout.astro";
import { ReviewPlayground } from "../components/ReviewPlayground";
---

<Layout title="把过程，变成下一次的方法">
  <div class="review-page">
    <div class="review-intro">
      <span class="page-eyebrow">KEEP THE METHOD</span>
      <h1>把过程，变成下一次的方法。</h1>
      <p>
        五个协作动作，一份可复用的提示词骨架。需要时，回到对应案例查看细节。
      </p>
    </div>
    <ReviewPlayground client:load />
  </div>
</Layout>
