---
import Layout from "../layouts/Layout.astro";
import {
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Check,
  GitBranch,
  Lightbulb,
  MessageSquareText,
  Search,
  ShieldCheck,
  TerminalSquare,
} from "lucide-react";
import { CopyButton } from "../components/CopyButton";
const principles = [
  {
    num: "01",
    icon: MessageSquareText,
    title: "提示词写的是任务，不是愿望。",
    desc: "交代使用者、目标、约束和验收标准。把“帮我优化一下”换成能被检查的具体要求。",
    example: "375px 下项目卡片改为单列；保留配色、文案与邮件入口。",
  },
  {
    num: "02",
    icon: Search,
    title: "先读已有项目，再决定怎么改。",
    desc: "让 AI 说明数据如何流动、关键文件在哪里。API 已经透传完整对象，就不必重写一层封装。",
    example: "先看 TodoForm → App → api/todos → 路由 → SQLite 的数据流。",
  },
  {
    num: "03",
    icon: BookOpen,
    title: "计划与上下文，是共同的工作底稿。",
    desc: "在开始前对齐范围；跨轮次保留关键决策和未完成事项。不要让 AI 在长对话里猜你的优先级。",
    example: "新增可选 notes，不改认证、不替换数据库、不重构状态管理。",
  },
  {
    num: "04",
    icon: TerminalSquare,
    title: "AI 说完成，不等于真的完成。",
    desc: "运行项目、打开页面、核对结果。检查失败时记录命令、输出与原因，不把“看起来能跑”写成“已验证”。",
    example: "新增 → 刷新 → 编辑 → 清空 → 再刷新；检查旧任务与完成状态。",
  },
  {
    num: "05",
    icon: GitBranch,
    title: "小步修改，小步验证，小步提交。",
    desc: "每次解决一个明确问题。看 diff 是否出现无关重构，确认没有丢掉用户已有改动。",
    example: "先改响应式样式，验证两种宽度，再提交一个职责单一的版本。",
  },
  {
    num: "06",
    icon: ShieldCheck,
    title: "把专业判断留在人这一侧。",
    desc: "核对许可证、敏感数据、破坏性命令与外部依赖。工具可以代劳，但不替你承担交付责任。",
    example: "未标注许可证的公开仓库，不等于可以直接整体复制再分发。",
  },
];
const template =
  "目标：为谁解决什么问题？\n上下文：项目技术栈、关键文件、已知约束。\n范围：这次做什么，明确不做什么。\n计划：先解释现状与修改顺序，等确认再实现。\n验证：运行哪些命令、检查哪些用户行为？\n交付：说明改动文件、实际验证结果和剩余事项。";
---

<Layout title="把经验变成方法">
  <div class="breadcrumb">
    <a href="/">学习路径</a>
    <span>/</span>工程手记
  </div>
  <section class="page-heading">
    <span class="eyebrow">THE TAKEAWAYS · BEYOND THE TOOLS</span>
    <h1>
      工具会变，方法留下来<span class="orange-period">。</span>
    </h1>
    <p>
      AI Coding 不是把开发责任交出去，
      <br />
      而是用更清楚的协作，把一个想法可靠地交付。
    </p>
  </section>
  <div class="review-quote">
    <span>“</span>
    <h2>
      少一点「帮我做完」，
      <br />
      多一点「我们怎样确认做好了」。
    </h2>
    <p>从两个案例带走的，应该不只是一份代码。</p>
  </div>
  <section class="principles-grid">
    {principles.map((item) => (
      <article>
        <div class="principle-top">
          <span>{item.num}</span>
          <item.icon size={21} />
        </div>
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
        <div class="principle-example">
          <Lightbulb size={14} />
          <span>{item.example}</span>
        </div>
      </article>
    ))}
  </section>
  <section class="content-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">KEEP THIS HANDY</span>
        <h2>下一次任务，从这张卡片开始。</h2>
      </div>
    </div>
    <div class="template-card">
      <div class="template-header">
        <span>一份可复用的协作模板</span>
        <CopyButton text={template} label="复制模板" client:load />
      </div>
      <pre>{template}</pre>
    </div>
  </section>
  <div class="next-chapter">
    <div>
      <span class="eyebrow">NOW, MAKE IT YOURS</span>
      <h3>换成你的真实需求，再走一遍。</h3>
      <p>不是照抄结果，而是带着方法做自己的作品。</p>
    </div>
    <a class="primary-button" href="/case/from-scratch">
      重新探索案例 <ArrowRight size={16} />
    </a>
  </div>
</Layout>
