---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/ui/Arrow.astro";
---

<Layout title="页面没有找到">
  <div class="home-section">
    <section>
      <span class="eyebrow">404 · 页面未找到</span>
      <h1>这一步，暂时没有内容。</h1>
      <p>从学习路线继续，或回到首页查看两个交互案例。</p>
    </section>
    <div class="inline-actions">
      <a href="/start/" class="button">
        返回学习路线 <Arrow />
      </a>
      <a href="/" class="button secondary">
        回到首页
      </a>
    </div>
  </div>
</Layout>
