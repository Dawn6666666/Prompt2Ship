---
import Layout from "../../layouts/Layout.astro";
import { TodoLesson } from "../../components/TodoLesson";
import { todoChanges } from "../../data/todo";
import { highlightPair } from "../../lib/highlight";
import evidence from "../../data/todo-evidence.json";
const highlighted = await Promise.all(
  todoChanges.map((s) => highlightPair(s.before, s.after, s.lang)),
);
---

<Layout title="案例二：给 Todo 增加任务备注" workspace>
  <div class="case-page-head">
    <a class="case-back" href="/learn/">
      ← 学习路线
    </a>
    <div>
      <span class="page-eyebrow">CASE STUDY / 02</span>
      <h1>
        一条备注，走过整个项目<span>。</span>
      </h1>
      <p>
        从读懂已有代码开始，沿着前端、接口和数据库，完成一次有边界的全栈修改。
      </p>
    </div>
    <div class="case-meta">
      <span>React / Express / SQLite</span>
      <span>7 个动态</span>
      <span>已有项目改造</span>
    </div>
  </div>
  <TodoLesson highlighted={highlighted} evidence={evidence} client:load />
</Layout>
