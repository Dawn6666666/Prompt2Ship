---
import Layout from "../../layouts/Layout.astro";
import { TodoLesson } from "../../components/TodoLesson";
import { todoChanges } from "../../data/todo";
import { highlightPair } from "../../lib/highlight";
import { Accordion } from "../../components/ui/accordion";
const highlighted = await Promise.all(
  todoChanges.map((s) => highlightPair(s.before, s.after, s.lang)),
);
const details = [
  {
    title: "参考项目与本地跟做说明",
    content:
      "结构参考 Baoxd123/todo-app（a5a648a）。公开仓库未标注许可证，本站不分发完整项目。上述代码是整合片段。若已获得项目使用权限：根目录 npm install，两个终端分别运行 npm run dev -w todo-server 和 npm run dev -w todo-client；前端检查运行 npm run build -w todo-client。better-sqlite3 需要兼容的 Node 环境，勿删除旧数据库绕过迁移。验证新增、刷新、编辑、清空、完成状态、旧任务、筛选和拖拽。",
  },
];
---

<Layout title="案例二：给 Todo 增加备注">
  <div class="lesson-page-heading">
    <div>
      <a href="/">学习实验室</a>
      <span>/</span>
      <span>案例 02</span>
    </div>
    <p>
      不重写，也能做好一次改动。<span>跟着一条备注，走完前后端。</span>
    </p>
    <a href="/case/from-scratch">案例 01 ↗</a>
  </div>
  <TodoLesson highlighted={highlighted} client:load />
  <div class="source-note">
    <a
      href="https://github.com/Baoxd123/todo-app"
      target="_blank"
      rel="noreferrer"
    >
      参考项目 ↗
    </a>{" "}
    · React / Express / SQLite · 关键改动片段，不是完整项目分发。
  </div>
  <Accordion items={details} client:load />
</Layout>
