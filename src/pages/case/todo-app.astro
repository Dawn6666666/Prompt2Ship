---
import Layout from "../../layouts/Layout.astro";
import { TodoLesson } from "../../components/TodoLesson";
import { todoChanges } from "../../data/todo";
import { highlightPair } from "../../lib/highlight";
import { Accordion } from "../../components/ui/accordion";
const highlighted = await Promise.all(
  todoChanges.map((s) => highlightPair(s.before, s.after, s.lang)),
);
const details = [
  {
    title: "参考项目与演示范围",
    content:
      "结构参考 Baoxd123/todo-app（a5a648a）。公开仓库未标注许可证，本站不分发完整项目。代码对比展示关键整合片段；最后的数据流程是固定示例回放，不运行后端或读写数据库，也不代表真实项目已经通过验证。",
  },
];
---

<Layout title="案例二：给 Todo 增加备注" workspace>
  <TodoLesson highlighted={highlighted} client:load />
  <div class="source-note">
    <a
      href="https://github.com/Baoxd123/todo-app"
      target="_blank"
      rel="noreferrer"
    >
      参考项目 ↗
    </a>{" "}
    · React / Express / SQLite · 关键改动片段，不是完整项目分发。
  </div>
  <Accordion items={details} client:load />
</Layout>
