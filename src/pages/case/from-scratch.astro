---
import Layout from "../../layouts/Layout.astro";
import { CaseWorkbench } from "../../components/CaseWorkbench";
import { stages, portfolioHtml } from "../../data/course";
import { highlightPair, highlight } from "../../lib/highlight";
const [highlighted, source] = await Promise.all([
  Promise.all(stages.map((s) => highlightPair(s.before, s.after, s.lang))),
  highlight(portfolioHtml(2).replace(/></g, ">\n<"), "html"),
]);
---

<Layout title="案例一：从零做一个作品网站" workspace>
  <div class="case-page-head">
    <a class="case-back" href="/learn/">
      ← 学习路线
    </a>
    <div>
      <span class="page-eyebrow">CASE STUDY / 01</span>
      <h1>
        从一句想法，到一个网站<span>。</span>
      </h1>
      <p>
        一个简单作品集，七个开发阶段。沿着提示词、代码与运行效果，看见项目逐步成形。
      </p>
    </div>
    <div class="case-meta">
      <span>HTML / CSS</span>
      <span>7 个动态</span>
      <span>从零构建</span>
    </div>
  </div>
  <CaseWorkbench highlighted={highlighted} sources={[source]} client:load />
</Layout>
