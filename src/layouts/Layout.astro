---
import { Header } from "../components/Header";
import "@fontsource-variable/inter";
import "../styles/global.css";
const {
  title = "让想法，真正上线。",
  description = "面向刚接触 Vibe Coding 的同学，从安装 IDE、编程 Agent、初始化项目开始，用交互演示看懂需求分析到作品交付。",
  workspace = false,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f9f6" />
    <title>{title} — Prompt2Ship</title>
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      const theme = localStorage.getItem("theme");
      document.documentElement.classList.toggle(
        "dark",
        theme === "dark" ||
          (!theme && matchMedia("(prefers-color-scheme: dark)").matches),
      );
    </script>
  </head>
  <body class:list={{ "workspace-page": workspace }}>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <Header path={path} client:load />
    <main id="main" class="main-content">
      <slot />
      {!workspace && (
        <footer class="site-footer">
          <span>
            Prompt2Ship <span class="muted">/ 让好想法落地。</span>
          </span>
          <span>
            <a href="/setup">从零上手</a> · <a href="/review">方法复盘</a>
          </span>
        </footer>
      )}
    </main>
  </body>
</html>
