---
import { Header } from "../components/Header";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/workbench.css";
const {
  title = "和 AI 一起，做出你的第一个网页",
  description = "从 VS Code 和编程 Agent 开始，通过可操作的案例，看懂 AI 如何参与需求、代码、验证与交付。",
  workspace = false,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fafaf8" />
    <title>{title} — Prompt2Ship</title>
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try {
        const saved =
          localStorage.getItem("theme") ||
          localStorage.getItem("starlight-theme");
        const dark =
          saved === "dark" ||
          ((!saved || saved === "auto") &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      } catch {}
    </script>
  </head>
  <body class:list={["p-site", { "p-workspace": workspace }]}>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <Header path={Astro.url.pathname} client:load />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Prompt2Ship · 一份可以跟着做的 AI 编程入门指南</span>
      <p>
        命令输出和 Agent 对话是预设演示；个人主页预览是真实
        HTML。本站不读取你的电脑，也不调用 AI。
      </p>
      <a href="/guide/">方法速查 ↗</a>
    </footer>
  </body>
</html>
